APP_NAME=FaceAttend AI
ENVIRONMENT=development

DATABASE_URL=sqlite:///./data/face_attendance.db

APP_TIMEZONE=Africa/Cairo

JWT_SECRET_KEY=change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

AI_MODEL_PATH=ai/models/w600k_r50.onnx
AI_MODEL_VERSION=arcface-w600k-r50-v1
FACE_DETECTOR_MODEL_PATH=ai/models/face_detection_yunet.onnx

FACE_RECOGNITION_THRESHOLD=0.50
FACE_RECOGNITION_BORDERLINE_BAND=0.05

LIVENESS_ENABLED=true
LIVENESS_MODE=motion

RECOGNITION_INTERVAL_MS=500
ATTENDANCE_COOLDOWN_SECONDS=30
RECOGNITION_RATE_LIMIT_PER_MINUTE=15

SAVE_ATTENDANCE_SNAPSHOT=false
MAX_IMAGE_SIZE_MB=5

EMBEDDING_ENCRYPTION_KEY=change_this_in_production

IMAGE_RETENTION_DAYS=90

CORS_ALLOWED_ORIGINS=http://localhost:8000
